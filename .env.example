# Copy this file to .env.local (local) and add the same values in Vercel → Settings → Environment Variables.
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key ONLY. NEVER put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Optional (used for sitemap.xml): your public site address
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
